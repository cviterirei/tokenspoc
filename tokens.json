{
  "$description": "Design Tokens following the Design Tokens Format Module 2025.10 specification",
  "color": {
    "$description": "Color tokens",
    "primary": {
      "$type": "color",
      "$value": "#0066CC",
      "$description": "Primary brand color"
    },
    "secondary": {
      "$type": "color",
      "$value": "#6B7280",
      "$description": "Secondary brand color"
    },
    "success": {
      "$type": "color",
      "$value": "#10B981",
      "$description": "Success state color"
    }
  },
  "dimension": {
    "$description": "Dimension tokens for spacing and sizing",
    "small": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Small spacing unit"
    },
    "medium": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Medium spacing unit"
    },
    "large": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "Large spacing unit"
    }
  },
  "fontFamily": {
    "$description": "Font family tokens",
    "primary": {
      "$type": "fontFamily",
      "$value": ["Inter", "Helvetica Neue", "sans-serif"],
      "$description": "Primary font family for body text"
    },
    "heading": {
      "$type": "fontFamily",
      "$value": ["Poppins", "Arial", "sans-serif"],
      "$description": "Font family for headings"
    },
    "monospace": {
      "$type": "fontFamily",
      "$value": ["Fira Code", "Consolas", "monospace"],
      "$description": "Monospace font family for code"
    }
  },
  "fontWeight": {
    "$description": "Font weight tokens",
    "regular": {
      "$type": "fontWeight",
      "$value": 400,
      "$description": "Regular font weight"
    },
    "medium": {
      "$type": "fontWeight",
      "$value": 500,
      "$description": "Medium font weight"
    },
    "bold": {
      "$type": "fontWeight",
      "$value": 700,
      "$description": "Bold font weight"
    }
  },
  "duration": {
    "$description": "Duration tokens for animations",
    "fast": {
      "$type": "duration",
      "$value": "100ms",
      "$description": "Fast animation duration"
    },
    "normal": {
      "$type": "duration",
      "$value": "250ms",
      "$description": "Normal animation duration"
    },
    "slow": {
      "$type": "duration",
      "$value": "500ms",
      "$description": "Slow animation duration"
    }
  },
  "cubicBezier": {
    "$description": "Cubic bezier easing functions",
    "easeIn": {
      "$type": "cubicBezier",
      "$value": [0.42, 0, 1, 1],
      "$description": "Ease-in animation curve"
    },
    "easeOut": {
      "$type": "cubicBezier",
      "$value": [0, 0, 0.58, 1],
      "$description": "Ease-out animation curve"
    },
    "easeInOut": {
      "$type": "cubicBezier",
      "$value": [0.42, 0, 0.58, 1],
      "$description": "Ease-in-out animation curve"
    }
  },
  "number": {
    "$description": "Number tokens for unitless values",
    "lineHeightTight": {
      "$type": "number",
      "$value": 1.25,
      "$description": "Tight line height"
    },
    "lineHeightNormal": {
      "$type": "number",
      "$value": 1.5,
      "$description": "Normal line height"
    },
    "lineHeightLoose": {
      "$type": "number",
      "$value": 1.75,
      "$description": "Loose line height"
    }
  },
  "strokeStyle": {
    "$description": "Stroke style tokens for borders",
    "solid": {
      "$type": "strokeStyle",
      "$value": "solid",
      "$description": "Solid stroke style"
    },
    "dashed": {
      "$type": "strokeStyle",
      "$value": "dashed",
      "$description": "Dashed stroke style"
    },
    "dotted": {
      "$type": "strokeStyle",
      "$value": "dotted",
      "$description": "Dotted stroke style"
    }
  },
  "border": {
    "$description": "Composite border tokens",
    "thin": {
      "$type": "border",
      "$value": {
        "color": "#E5E7EB",
        "width": "1px",
        "style": "solid"
      },
      "$description": "Thin border style"
    },
    "medium": {
      "$type": "border",
      "$value": {
        "color": "#D1D5DB",
        "width": "2px",
        "style": "solid"
      },
      "$description": "Medium border style"
    },
    "thick": {
      "$type": "border",
      "$value": {
        "color": "#9CA3AF",
        "width": "4px",
        "style": "dashed"
      },
      "$description": "Thick dashed border style"
    }
  },
  "transition": {
    "$description": "Transition tokens for animations",
    "fast": {
      "$type": "transition",
      "$value": {
        "duration": "100ms",
        "delay": "0ms",
        "timingFunction": [0.42, 0, 0.58, 1]
      },
      "$description": "Fast transition"
    },
    "normal": {
      "$type": "transition",
      "$value": {
        "duration": "250ms",
        "delay": "0ms",
        "timingFunction": [0.42, 0, 0.58, 1]
      },
      "$description": "Normal transition"
    },
    "slow": {
      "$type": "transition",
      "$value": {
        "duration": "500ms",
        "delay": "50ms",
        "timingFunction": [0, 0, 0.58, 1]
      },
      "$description": "Slow transition with delay"
    }
  },
  "shadow": {
    "$description": "Shadow tokens for elevation",
    "small": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#00000026",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
      ],
      "$description": "Small shadow for subtle elevation"
    },
    "medium": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#00000033",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "8px",
          "spread": "0px"
        }
      ],
      "$description": "Medium shadow for cards"
    },
    "large": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#00000040",
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "16px",
          "spread": "0px"
        },
        {
          "color": "#00000020",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "6px",
          "spread": "-2px"
        }
      ],
      "$description": "Large shadow with multiple layers for high elevation"
    }
  },
  "gradient": {
    "$description": "Gradient tokens for backgrounds",
    "primaryLinear": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#0066CC",
          "position": 0
        },
        {
          "color": "#004499",
          "position": 1
        }
      ],
      "$description": "Primary linear gradient"
    },
    "secondaryLinear": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#F3F4F6",
          "position": 0
        },
        {
          "color": "#E5E7EB",
          "position": 0.5
        },
        {
          "color": "#D1D5DB",
          "position": 1
        }
      ],
      "$description": "Secondary linear gradient with three stops"
    },
    "accentLinear": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#8B5CF6",
          "position": 0
        },
        {
          "color": "#EC4899",
          "position": 1
        }
      ],
      "$description": "Accent gradient for highlights"
    }
  },
  "typography": {
    "$description": "Typography composite tokens",
    "headingLarge": {
      "$type": "typography",
      "$value": {
        "fontFamily": ["Poppins", "Arial", "sans-serif"],
        "fontSize": "32px",
        "fontWeight": 700,
        "lineHeight": 1.25,
        "letterSpacing": "-0.02em"
      },
      "$description": "Large heading typography"
    },
    "bodyRegular": {
      "$type": "typography",
      "$value": {
        "fontFamily": ["Inter", "Helvetica Neue", "sans-serif"],
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0em"
      },
      "$description": "Regular body text typography"
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": ["Inter", "Helvetica Neue", "sans-serif"],
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0.01em"
      },
      "$description": "Caption typography for small text"
    }
  }
}
